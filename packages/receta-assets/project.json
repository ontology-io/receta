{
  "name": "receta-assets",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/receta-assets/src",
  "projectType": "library",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["receta:build"],
      "options": {
        "command": "bun scripts/check.ts",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["receta:build"],
      "options": {
        "command": "tsc --noEmit",
        "cwd": "{projectRoot}"
      }
    }
  }
}
