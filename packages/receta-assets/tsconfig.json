{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // The receta-skills scripts import each other with .ts extensions, which Node needs.
    "allowImportingTsExtensions": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["bun"]
  },
  "include": ["src/**/*", "scripts/**/*"],
  "exclude": ["node_modules", ".examples"]
}
