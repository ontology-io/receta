{
  "name": "@ontologyio/receta-monorepo",
  "private": true,
  "description": "Monorepo for @ontologyio/receta packages",
  "author": "Khaled Maher",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ontology-io/receta.git"
  },
  "bugs": {
    "url": "https://github.com/ontology-io/receta/issues"
  },
  "homepage": "https://github.com/ontology-io/receta#readme",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "nx run-many --target=build --all",
    "test": "nx run-many --target=test --all",
    "test:watch": "bun test --watch",
    "typecheck": "nx run-many --target=typecheck --all",
    "clean": "nx run-many --target=clean --all",
    "lint": "nx run-many --target=lint --all",
    "website:dev": "cd website && bun run dev",
    "website:build": "cd website && bun run build",
    "ci": "act --container-architecture linux/amd64 -P ubuntu-latest=node:20-bookworm-slim",
    "ci:test": "act -j test --container-architecture linux/amd64 -P ubuntu-latest=node:20-bookworm-slim",
    "ci:lint": "act -j lint --container-architecture linux/amd64 -P ubuntu-latest=node:20-bookworm-slim",
    "ci:list": "act -l",
    "ci:dry-run": "act -n",
    "website:check": "cd website && bun run check:examples && bun run check:links",
    "website:deploy": "cd website && bun run deploy"
  },
  "devDependencies": {
    "@nx/js": "^22.4.4",
    "@types/bun": "latest",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "fast-check": "^4.5.3",
    "nx": "^22.4.4",
    "tsup": "^9.0.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
